
<Window x:Class="toybox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOYBOX - Manajemen Toko Mainan"
        Height="760" Width="1250"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">


<Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#D5E1ED"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,13"/>
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#315779"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FFD166"/>
                            <Setter Property="Foreground" Value="#173654"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#173654" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="🧸 TOYBOX"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"
                               Margin="0,8,0,35"/>

                    <Button Content="Dashboard"
                            Click="Dashboard_Click"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Produk"
                            Click="Produk_Click"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Manajemen Stok"
                            Click="Stok_Click"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Kasir"
                            Click="Kasir_Click"
                            Style="{StaticResource NavButton}"/>

                    <Button Content="Laporan"
                            Click="Laporan_Click"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="TOYBOX v1.0"
                           Foreground="#B9C9D8"
                           Margin="0,15,0,5"/>
            </DockPanel>
        </Border>

        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Margin="28"/>
    </Grid>
</Window>
